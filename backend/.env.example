# Static beneficiary/wire display details returned to an investor requesting a `FundingInstruction`
# -- Austial is the *beneficiary of a bank*, not a payment system operator (see `ledger` module's
# docstrings), so these describe Austial's own IBU settlement account at its banking partner, not
# a per-investor account.
LEDGER_BENEFICIARY_NAME="Austial GIFT City IBU Client Settlement Account"
LEDGER_BENEFICIARY_BANK_NAME=changeme
LEDGER_BENEFICIARY_ACCOUNT_NUMBER=changeme
LEDGER_BENEFICIARY_SWIFT_BIC=changeme
